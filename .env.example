# These are picked up only when running locally without docker-compose.
# docker-compose.yml sets these directly for the containers.

# Backend
DATABASE_URL=postgresql://roster:rosterpass@localhost:5432/roster_db?schema=public
JWT_SECRET=change-this-jwt-secret-in-production-please
JWT_EXPIRES_IN=7d
PORT=3001
CORS_ORIGIN=http://localhost:3000
ORG_CODE_PREFIX=ORG
ORG_CODE_PAD=4
PROJECT_CODE_PREFIX=PROJ
PROJECT_CODE_PAD=4

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
